# Copy this file to .env.local and replace the placeholders with values from Supabase.
# Use your Project URL and anon/public (or publishable) key only.
# NEVER put the service_role / secret key in a Vite frontend.
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY
